# ============================================================================
# Root environment for docker compose.
#   cp .env.example .env   (then fill in SECRET_KEY and POSTGRES_PASSWORD)
# `docker compose` loads this file automatically and substitutes the values
# into both docker-compose.yml and docker-compose.prod.yml.
# The real .env is git-ignored — never commit it.
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
# Used to configure the db service AND to build the backend's DATABASE_* vars.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=complaints
# Host port for the db (change if 5432 is already in use, e.g. a local Postgres)
POSTGRES_HOST_PORT=5432

# --- Backend (FastAPI) ------------------------------------------------------
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_PORT=8000

# --- Frontend (Vite) --------------------------------------------------------
# Port the Vite dev server is published on (dev stack).
FRONTEND_PORT=5173
# Port nginx is published on (production stack).
FRONTEND_HTTP_PORT=8080
# Browser-facing backend URL. The browser runs on the HOST, so use localhost —
# NOT the compose service name "backend".
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Where the backend redirects the browser after OAuth / verification links.
FRONTEND_BASE_URL=http://localhost:5173

# --- Email (required by backend/app/config.py; may be empty in dev) ---------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Third-party integrations (optional in dev) -----------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# --- Reload tuning ----------------------------------------------------------
# Set to 1 if uvicorn's file watching misses changes through the bind mount
# (common on Docker Desktop for Windows/macOS and on network drives).
WATCHFILES_FORCE_POLLING=
