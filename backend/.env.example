# ============================================================================
# Core Application Configuration
# ============================================================================
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=your_db_name
DATABASE_USERNAME=postgres
SECRET_KEY=your_super_secret_key_for_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_BASE_URL=http://localhost:3000

# ============================================================================
# AI Model Paths (HuggingFace Transformers)
# ============================================================================
# Provide absolute paths to the model directories.

# Arabic Models
# AR_ARABERT_SENTIMENT_PATH=path/to/your/app/models/arabic/arabert_85
# AR_ARABERT_EMOTION_PATH=path/to/your/app/models/arabic/arabert_70
# AR_ARABERT_PROBLEM_PATH=path/to/your/app/models/arabic/arabert_67

# English Models
# EN_ROBERTA_SENTIMENT_PATH=path/to/your/app/models/english/roberta_73_sentiment
# EN_ROBERTA_EMOTION_PATH=path/to/your/app/models/english/roberta_73_emotion
# EN_ROBERTA_PROBLEM_PATH=path/to/your/app/models/english/roberta_70

# ============================================================================
# Third-Party Service Credentials
# ============================================================================
# Gmail for sending emails
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Facebook Integration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://yourapi.com/api/v1/integrations/facebook/callback

# Twitter Integration
TWITTER_AUTH_TOKEN=your_twitter_auth_token
TWITTER_CT0=your_twitter_ct0_token

# Hugging Face API Token (optional, for downloading models)
# hugging_face_token=your_hf_token
