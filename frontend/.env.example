# Ara2kom AI - Frontend Environment Configuration
# 
# Copy this file to .env.local or .env.production and fill in the values.
# 
# TODO (FastAPI Backend Team):
# - Set the base URL to your FastAPI backend
# - Ensure CORS is configured to allow this frontend origin
# - All API endpoints should be prefixed with /api/v1/
# 
# TODO (Frontend Team):
# - .env.local ---- used for local development (localhost)
# - .env.staging --- used for staging deployment
# - .env.production - used for production deployment

# Development: Local backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Staging: Backend staging server
# VITE_API_BASE_URL=https://api-staging.ara2kom.ai/api/v1

# Production: Backend production server
# VITE_API_BASE_URL=https://api.ara2kom.ai/api/v1

